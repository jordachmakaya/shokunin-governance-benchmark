# ==============================================================================
# Shokunin Benchmarks Environment Configuration
# ==============================================================================
# Invariant: Core governance gates, unit tests, and hook materializers are 100%
# hermetic and execute offline with zero network/credential dependencies.
#
# Credentials below are injected ONLY into explicitly authorized Harbor trial
# execution jobs or external telemetry sinks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Harbor Container & Execution Runtime (ZB2, ZB5)
# ------------------------------------------------------------------------------
# Environment mode: 'local' | 'container' | 'ci'
HARBOR_ENVIRONMENT=local
# Log verbosity: 'debug' | 'info' | 'warn' | 'error'
HARBOR_LOG_LEVEL=info
# Base directory for transient trial workspaces (defaults to system tmp)
# HARBOR_WORKSPACE_DIR=/tmp/shokunin-trials
# Container runtime engine: 'docker' | 'podman'
# HARBOR_CONTAINER_RUNTIME=docker

# ------------------------------------------------------------------------------
# 2. Telemetry & Observability (ZB4 / Hooks)
# ------------------------------------------------------------------------------
# OpenTelemetry OTLP collector endpoint for trial telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=shokunin-benchmarks

# Langfuse observability (optional, for trial trajectory inspection)
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 3. Model Provider Credentials (Injected into Harbor task containers only)
# ------------------------------------------------------------------------------
# Required only when running live model trials (A0-A3 experimental arms).
# NEVER commit populated .env files to version control.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
